---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>

    <style>
      :root {
        font-family: system-ui, sans-serif;
        line-height: 1.6;
      }

      body {
        margin: 0;
        color: #222;
        background: #fff;
      }

      header {
        border-bottom: 1px solid #ddd;
        padding: 1rem 2rem;
      }

      nav {
        display: flex;
        gap: 1.4rem;
        flex-wrap: wrap;
      }

      nav a {
        color: inherit;
        text-decoration: none;
      }

      nav a:hover {
        text-decoration: underline;
      }

      main {
        max-width: 1100px;
        margin: auto;
        padding: 3rem 2rem;
      }

      footer {
        max-width: 1100px;
        margin: auto;
        padding: 2rem;
        border-top: 1px solid #ddd;
      }

      .grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: 1rem;
      }

      .card {
        border: 1px solid #ddd;
        padding: 1.5rem;
        border-radius: 8px;
      }
    </style>
  </head>

  <body>
    <header>
      <strong>Your Name</strong>

      <nav>
        <a href="/">Home</a>
        <a href="/research/">Research</a>
        <a href="/papers/">Papers</a>
        <a href="/projects/">Projects</a>
        <a href="/simulations/">Simulations</a>
        <a href="/labs/">Labs</a>

        <a href="/notes/">Notes</a>
        <a href="/computational-notes/">Quarto</a>
        <a href="/docs/">Software Docs</a>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer>
      Built with Astro · GitHub Pages
    </footer>
  </body>
</html>
