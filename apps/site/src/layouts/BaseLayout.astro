---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>

    <style>
      :root {
        --bg: #f5f7fb;
        --panel: #ffffff;
        --panel-alt: #eef3ff;
        --text: #111827;
        --muted: #4b5563;
        --line: #dfe7f5;
        --primary: #0f172a;
        --accent: #2563eb;
        font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        line-height: 1.6;
        color: var(--text);
        background: var(--bg);
      }

      * { box-sizing: border-box; }

      body {
        margin: 0;
        color: var(--text);
        background: linear-gradient(180deg, #f8fafc 0%, #eef4ff 100%);
      }

      a {
        color: var(--accent);
      }

      header {
        position: sticky;
        top: 0;
        z-index: 10;
        background: rgba(255, 255, 255, 0.8);
        backdrop-filter: blur(10px);
        border-bottom: 1px solid var(--line);
        padding: 1rem 1.25rem;
      }

      .site-header {
        max-width: 1180px;
        margin: 0 auto;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
      }

      .brand {
        font-weight: 700;
        text-decoration: none;
        color: var(--primary);
      }

      nav {
        display: flex;
        gap: 0.9rem;
        flex-wrap: wrap;
      }

      nav a {
        color: var(--muted);
        text-decoration: none;
        font-size: 0.95rem;
      }

      nav a:hover {
        color: var(--primary);
        text-decoration: underline;
      }

      main {
        max-width: 1180px;
        margin: 0 auto;
        padding: 3rem 1.25rem 4rem;
      }

      h1, h2, h3 {
        line-height: 1.2;
        margin-top: 0;
      }

      .hero {
        margin-bottom: 2rem;
      }

      .eyebrow {
        text-transform: uppercase;
        letter-spacing: 0.12em;
        font-size: 0.72rem;
        color: var(--accent);
        font-weight: 700;
        margin-bottom: 0.75rem;
      }

      .lead {
        font-size: 1.1rem;
        color: var(--muted);
        max-width: 62ch;
      }

      .grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 1rem;
      }

      .card {
        background: rgba(255,255,255,0.96);
        border: 1px solid var(--line);
        border-radius: 14px;
        padding: 1.3rem 1.4rem;
        box-shadow: 0 8px 20px rgba(15, 23, 42, 0.03);
      }

      .card h2 {
        margin-bottom: 0.5rem;
        font-size: 1.1rem;
      }

      .card p {
        color: var(--muted);
        margin-bottom: 0.9rem;
      }

      .card a {
        font-weight: 600;
        text-decoration: none;
      }

      .section {
        margin-top: 2.5rem;
      }

      .tag-list {
        display: flex;
        gap: 0.5rem;
        flex-wrap: wrap;
        list-style: none;
        padding: 0;
        margin: 1rem 0 0;
      }

      .tag-list li {
        background: var(--panel-alt);
        color: var(--primary);
        border: 1px solid var(--line);
        border-radius: 999px;
        padding: 0.35rem 0.7rem;
        font-size: 0.82rem;
      }

      .stack {
        display: grid;
        gap: 1rem;
      }

      footer {
        max-width: 1180px;
        margin: 0 auto;
        padding: 1rem 1.25rem 2.5rem;
        border-top: 1px solid var(--line);
        color: var(--muted);
      }
    </style>
  </head>

  <body>
    <header>
      <div class="site-header">
        <a class="brand" href="/">Your Name</a>

        <nav>
          <a href="/">Home</a>
          <a href="/research/">Research</a>
          <a href="/papers/">Papers</a>
          <a href="/projects/">Projects</a>
          <a href="/simulations/">Simulations</a>
          <a href="/labs/">Labs</a>
          <a href="/notes/">Notes</a>
          <a href="/latex-notes/">LaTeX notes</a>
          <a href="/computational-notes/">Computational notes</a>
          <a href="/docs/">Docs</a>
          <a href="/cv/">CV</a>
          <a href="/about/">About</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer>
      Built with Astro · GitHub Pages · Computational laboratory
    </footer>
  </body>
</html>
