---
interface Props {
  title: string;
}

const { title } = Astro.props;

const navItems = [
  { href: "/", label: "Home" },
  { href: "/research/", label: "Research" },
  { href: "/papers/", label: "Papers" },
  { href: "/projects/", label: "Projects" },
  { href: "/simulations/", label: "Simulations" },
  { href: "/labs/", label: "Labs" },
  { href: "/notes/", label: "Notes" },
  { href: "/latex-notes/", label: "LaTeX Notes" },
  { href: "/computational-notes/", label: "Computational Notes" },
  { href: "/docs/", label: "Docs" },
  { href: "/cv/", label: "CV" },
  { href: "/about/", label: "About" },
];

const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <meta
      name="description"
      content="Personal computational website: research, notes, papers, software, simulations, and reproducible scientific work."
    />

    <style>
      :root {
        --bg: #f2f5fb;
        --panel: #ffffff;
        --panel-alt: #eef2fb;
        --text: #0f172a;
        --muted: #475569;
        --line: #d7deec;
        --primary: #0f172a;
        --accent: #1d4ed8;
        --accent-soft: #dbeafe;
        --shadow: 0 18px 35px rgba(15, 23, 42, 0.07);
        font-family: "Inter", "Source Sans Pro", "Segoe UI", system-ui, -apple-system, sans-serif;
        line-height: 1.72;
        color: var(--text);
        background: var(--bg);
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        color: var(--text);
        background: radial-gradient(circle at 0% -20%, #ffffff 0%, #f2f5fb 45%, #eef3fd 100%);
      }

      a {
        color: var(--accent);
      }

      header {
        position: sticky;
        top: 0;
        z-index: 10;
        background: rgba(248, 251, 255, 0.85);
        backdrop-filter: blur(12px);
        border-bottom: 1px solid var(--line);
        padding: 0.8rem 1.25rem;
      }

      .site-header {
        max-width: 1180px;
        margin: 0 auto;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
      }

      .brand {
        font-weight: 700;
        font-size: 1.03rem;
        text-decoration: none;
        color: var(--primary);
        letter-spacing: 0.01em;
      }

      nav {
        display: flex;
        gap: 0.32rem;
        flex-wrap: wrap;
        align-items: center;
        justify-content: flex-end;
      }

      nav a {
        color: #334155;
        text-decoration: none;
        font-size: 0.8rem;
        font-weight: 600;
        border-radius: 999px;
        padding: 0.26rem 0.58rem;
        border: 1px solid transparent;
        transition: all 160ms ease;
        line-height: 1.2;
        white-space: nowrap;
      }

      nav a:hover {
        color: var(--primary);
        background: var(--panel-alt);
        border-color: var(--line);
        text-decoration: none;
      }

      nav a.active {
        background: var(--accent-soft);
        border-color: #bfd6ff;
        color: #12367a;
      }

      main {
        max-width: 1180px;
        margin: 0 auto;
        padding: 3rem 1.25rem 4.2rem;
      }

      h1 {
        font-size: clamp(2rem, 4vw, 2.65rem);
        letter-spacing: -0.02em;
        margin-bottom: 0.8rem;
      }

      h2 {
        font-size: clamp(1.3rem, 2.2vw, 1.6rem);
        margin-bottom: 0.45rem;
      }

      h3 {
        font-size: 1.06rem;
      }

      h1,
      h2,
      h3 {
        line-height: 1.2;
        margin-top: 0;
      }

      .hero {
        margin-bottom: 2.2rem;
      }

      .eyebrow {
        text-transform: uppercase;
        letter-spacing: 0.13em;
        font-size: 0.72rem;
        color: var(--accent);
        font-weight: 700;
        margin-bottom: 0.75rem;
      }

      .lead {
        font-size: 1.08rem;
        color: var(--muted);
        max-width: 68ch;
      }

      .grid {
        display: grid;
        grid-template-columns: repeat(12, minmax(0, 1fr));
        gap: 0.9rem;
      }

      .card {
        background: rgba(255, 255, 255, 0.96);
        border: 1px solid var(--line);
        border-radius: 16px;
        padding: 1.35rem 1.45rem;
        box-shadow: var(--shadow);
      }

      .card h2 {
        margin-bottom: 0.5rem;
        font-size: 1.12rem;
      }

      .card p,
      .card li {
        color: var(--muted);
        margin-bottom: 0.8rem;
      }

      .card a {
        font-weight: 600;
        text-decoration: none;
      }

      .card a:hover {
        text-decoration: underline;
      }

      .section {
        margin-top: 2.8rem;
      }

      .quick-nav {
        display: flex;
        gap: 0.45rem;
        flex-wrap: wrap;
        margin: 0.8rem 0 1.45rem;
      }

      .quick-nav a {
        font-size: 0.83rem;
        font-weight: 600;
        text-decoration: none;
        color: #204486;
        background: #e9f1ff;
        border: 1px solid #c8d9f7;
        border-radius: 999px;
        padding: 0.25rem 0.6rem;
      }

      .quick-nav a:hover {
        background: #dde9ff;
      }

      .reading-section {
        display: grid;
        gap: 1rem;
        margin-top: 1rem;
      }

      .reading-section > article {
        background: var(--panel);
        border: 1px solid var(--line);
        border-radius: 14px;
        padding: 1.25rem 1.3rem;
        box-shadow: 0 10px 26px rgba(15, 23, 42, 0.04);
      }

      .reading-section > article h2 {
        margin-bottom: 0.45rem;
      }

      .reading-section > article p {
        color: var(--muted);
        margin-top: 0.2rem;
      }

      .split {
        display: grid;
        grid-template-columns: 2fr 1fr;
        gap: 1rem;
      }

      .muted-list {
        margin: 0.65rem 0 0;
        color: var(--muted);
      }

      .muted-list li {
        margin-bottom: 0.35rem;
      }

      .tag-list {
        display: flex;
        gap: 0.52rem;
        flex-wrap: wrap;
        list-style: none;
        padding: 0;
        margin: 1rem 0 0;
      }

      .tag-list li {
        background: var(--panel-alt);
        color: var(--primary);
        border: 1px solid var(--line);
        border-radius: 999px;
        padding: 0.36rem 0.75rem;
        font-size: 0.8rem;
        font-weight: 600;
      }

      .stack {
        display: grid;
        gap: 1.05rem;
      }

      .card.span-6 {
        grid-column: span 6;
      }

      .card.span-4 {
        grid-column: span 4;
      }

      .card.span-8 {
        grid-column: span 8;
      }

      .card.span-12 {
        grid-column: span 12;
      }

      footer {
        max-width: 1180px;
        margin: 0 auto;
        padding: 1rem 1.25rem 2.5rem;
        border-top: 1px solid var(--line);
        color: var(--muted);
        font-size: 0.93rem;
      }

      code {
        font-family: "IBM Plex Mono", "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
        background: #edf2fb;
        border-radius: 8px;
        padding: 0.12rem 0.4rem;
      }

      @media (max-width: 900px) {
        main {
          padding-top: 2.2rem;
        }

        nav a {
          font-size: 0.78rem;
          padding: 0.25rem 0.52rem;
        }

        .card.span-6,
        .card.span-8,
        .card.span-4 {
          grid-column: span 12;
        }

        .split {
          grid-template-columns: 1fr;
        }
      }

      @media (max-width: 640px) {
        .site-header {
          justify-content: flex-start;
        }

        .brand {
          width: 100%;
        }

        nav {
          justify-content: flex-start;
          gap: 0.28rem;
        }

        nav a {
          font-size: 0.76rem;
          padding: 0.24rem 0.5rem;
        }
      }
    </style>
  </head>

  <body>
    <header>
      <div class="site-header">
        <a class="brand" href="/">Your Name</a>

        <nav>
          {navItems.map((item) => (
            <a href={item.href} class={currentPath.startsWith(item.href) && item.href !== "/" ? "active" : currentPath === item.href ? "active" : ""}>
              {item.label}
            </a>
          ))}
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer>
      Built with Astro · GitHub Pages · Computational laboratory
    </footer>
  </body>
</html>
