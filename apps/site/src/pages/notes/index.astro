---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Notes | Your Name">
  <section class="hero">
    <p class="eyebrow">Notes</p>
    <h1>Knowledge garden and public notes</h1>
    <p class="lead">
      A digital-garden-style archive for mathematics, programming, stochastic processes, and personal notes.
    </p>
  </section>

  <div class="stack">
    <article class="card">
      <h2>Mathematics</h2>
      <p>Probability, measure theory, stochastic processes, and analysis.</p>
    </article>
    <article class="card">
      <h2>Programming</h2>
      <p>Algorithms, software design, scientific Python, and reproducible workflows.</p>
    </article>
    <article class="card">
      <h2>Electronics</h2>
      <p>Instrumentation, circuits, measurement techniques, and hardware debugging.</p>
    </article>
  </div>
</BaseLayout>
