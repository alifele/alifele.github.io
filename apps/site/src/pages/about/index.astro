---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="About | Your Name">
  <section class="hero">
    <p class="eyebrow">About</p>
    <h1>Personal computational website</h1>
    <p class="lead">
      A public laboratory for research, notes, software projects, and interactive scientific exploration.
    </p>
    <div class="quick-nav">
      <a href="#mission">Mission</a>
      <a href="#interests">Interests</a>
      <a href="#contact">Contact</a>
    </div>
  </section>

  <section class="reading-section">
    <article id="mission">
      <h2>Mission</h2>
      <p>To connect scientific writing, software, and interactive demonstrations into one coherent and navigable technical portfolio.</p>
    </article>

    <article id="interests">
      <h2>Research interests</h2>
      <ul class="muted-list">
        <li>Stochastic processes</li>
        <li>Statistical mechanics</li>
        <li>Scientific computing</li>
        <li>Electronics and instrumentation</li>
      </ul>
    </article>

    <article id="contact">
      <h2>Contact</h2>
      <p>Replace this section with your institutional affiliation, email, and professional links.</p>
    </article>
  </section>
</BaseLayout>
