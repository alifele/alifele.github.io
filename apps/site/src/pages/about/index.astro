---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="About | Your Name">
  <section class="hero">
    <p class="eyebrow">About</p>
    <h1>Personal computational website</h1>
    <p class="lead">
      This site acts as a public laboratory for research, computational notes, software projects, and interactive scientific exploration.
    </p>
  </section>

  <div class="stack">
    <article class="card">
      <h2>Mission</h2>
      <p>To connect scientific writing, software, and interactive demonstrations into one coherent digital portfolio.</p>
    </article>
    <article class="card">
      <h2>Interests</h2>
      <p>Stochastic processes, statistical mechanics, scientific computing, electronics, and reproducible research.</p>
    </article>
    <article class="card">
      <h2>Contact</h2>
      <p>Replace this with your email, institutional affiliation, and social links.</p>
    </article>
  </div>
</BaseLayout>
