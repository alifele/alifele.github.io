---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Projects | Your Name">
  <section class="hero">
    <p class="eyebrow">Projects</p>
    <h1>Software and electronics projects</h1>
    <p class="lead">
      Implementation-focused project pages with clear paths to source code, documentation, and experiments.
    </p>
    <div class="quick-nav">
      <a href="#software">Software</a>
      <a href="#electronics">Electronics</a>
      <a href="#documentation">Documentation</a>
    </div>
  </section>

  <section class="reading-section">
    <article id="software">
      <h2>Software projects</h2>
      <p>Scientific libraries, simulation engines, and reusable computational tools.</p>
      <p><a href="/projects/software/">Open software projects →</a></p>
    </article>

    <article id="electronics">
      <h2>Electronics projects</h2>
      <p>Hardware experiments, measurements, and engineering notebook style documentation.</p>
      <p><a href="/projects/electronics/">Browse electronics projects →</a></p>
    </article>

    <article id="documentation">
      <h2>Technical documentation</h2>
      <p>Project architecture, API notes, validation workflows, and usage guides.</p>
      <p><a href="/docs/">Read software docs →</a></p>
    </article>
  </section>
</BaseLayout>
