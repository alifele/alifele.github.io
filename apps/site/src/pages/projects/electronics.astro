---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Electronics Projects | Your Name">
  <section class="hero">
    <p class="eyebrow">Electronics</p>
    <h1>Engineering notebooks and hardware experiments</h1>
    <p class="lead">
      Hardware documentation with design intent, measurements, and revision history.
    </p>
    <div class="quick-nav">
      <a href="#analog">Analog</a>
      <a href="#embedded">Embedded</a>
      <a href="#practice">Practice</a>
    </div>
  </section>

  <section class="reading-section">
    <article id="analog">
      <h2>Analog experiments</h2>
      <ul class="muted-list">
        <li>555 timer and oscillator circuits</li>
        <li>Filter design and frequency-response analysis</li>
        <li>Signal path measurements and debugging records</li>
      </ul>
    </article>

    <article id="embedded">
      <h2>Embedded systems</h2>
      <p>Microcontroller and digital logic experiments with reproducible notes.</p>
      <ul class="muted-list">
        <li>Firmware testing logs</li>
        <li>Instrumentation setup and traces</li>
        <li>Revision history and design decisions</li>
      </ul>
    </article>

    <article id="practice">
      <h2>Documentation practice</h2>
      <p>Each project should include motivation, schematic references, measurements, and lessons learned.</p>
    </article>
  </section>
</BaseLayout>
