---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Electronics Projects | Your Name">
  <section class="hero">
    <p class="eyebrow">Electronics</p>
    <h1>Engineering notebooks and hardware experiments</h1>
    <p class="lead">
      This section is intended for schematics, component notes, measurements, and revision history.
    </p>
  </section>

  <div class="stack">
    <article class="card">
      <h2>555 timer experiments</h2>
      <p>Oscillator design, waveform analysis, and behavioural notes.</p>
    </article>
    <article class="card">
      <h2>Analog filters</h2>
      <p>Frequency response analysis and signal-processing experiments.</p>
    </article>
    <article class="card">
      <h2>Embedded systems</h2>
      <p>Microcontroller experiments, logic probes, and debugging records.</p>
    </article>
  </div>
</BaseLayout>
