---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Software Projects | Your Name">
  <section class="hero">
    <p class="eyebrow">Software</p>
    <h1>Software projects</h1>
    <p class="lead">
      Project pages for simulation code, numerical libraries, and reusable scientific software.
    </p>
    <div class="quick-nav">
      <a href="#flagship">Flagship</a>
      <a href="#libraries">Libraries</a>
      <a href="#tooling">Tooling</a>
    </div>
  </section>

  <section class="reading-section">
    <article id="flagship">
      <h2>Flagship project: DonorAcceptorMC</h2>
      <p>Monte Carlo sampling and statistical analysis for molecular systems.</p>
      <p><a href="/docs/donor-acceptor/">Open project documentation →</a></p>
    </article>

    <article id="libraries">
      <h2>Numerical libraries</h2>
      <p>Reusable routines for stochastic simulation, statistics, and model validation.</p>
      <ul class="muted-list">
        <li>Sampling kernels</li>
        <li>Observable estimators</li>
        <li>Diagnostics and plotting utilities</li>
      </ul>
    </article>

    <article id="tooling">
      <h2>Research tooling</h2>
      <p>Utilities for experiment orchestration, result analysis, and notebook integration.</p>
    </article>
  </section>
</BaseLayout>
