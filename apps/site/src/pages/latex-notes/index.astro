---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { latexNotes } from '../../data/latexNotes';
---

<BaseLayout title="LaTeX Notes | Your Name">
  <section class="hero">
    <p class="eyebrow">LaTeX Notes</p>
    <h1>Lecture notes (PDF archive)</h1>
    <p class="lead">
      Structured lecture notes authored in LaTeX and served as PDF files.
    </p>
    <div class="quick-nav">
      <a href="#catalog">Catalog</a>
      <a href="#usage">How to add</a>
      <a href="#paths">Folder paths</a>
    </div>
  </section>

  <section class="reading-section">
    <article id="catalog">
      <h2>Lecture note catalog</h2>
      <div class="stack">
        {latexNotes.map((note) => (
          <article class="card">
            <h3>{note.title}</h3>
            <p><strong>Course:</strong> {note.course}</p>
            <p><strong>Semester:</strong> {note.semester}</p>
            <p>{note.description}</p>
            <p>
              <a href={note.path} target="_blank" rel="noopener noreferrer">
                Open PDF in a new tab →
              </a>
            </p>
          </article>
        ))}
      </div>
    </article>

    <article id="usage">
      <h2>How to add your own notes</h2>
      <ol class="muted-list">
        <li>Put PDFs under <code>apps/site/public/latex-notes/</code> in course/topic folders.</li>
        <li>Add an item in <code>apps/site/src/data/latexNotes.ts</code>.</li>
        <li>Run <code>./scripts/build-astro.sh</code>.</li>
      </ol>
    </article>

    <article id="paths">
      <h2>Recommended folder structure</h2>
      <p>Use one folder per course or subject so links stay readable and organized.</p>
    </article>
  </section>
</BaseLayout>
