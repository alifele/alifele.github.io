---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="CV | Your Name">
  <section class="hero">
    <p class="eyebrow">CV</p>
    <h1>Curriculum vitae</h1>
    <p class="lead">
      Academic background, research experience, and technical skills in a scannable format.
    </p>
    <div class="quick-nav">
      <a href="#education">Education</a>
      <a href="#experience">Research experience</a>
      <a href="#skills">Skills</a>
    </div>
  </section>

  <section class="reading-section">
    <article id="education">
      <h2>Education</h2>
      <p>Doctoral / graduate / undergraduate entries should include institution, timeline, and focus area.</p>
    </article>

    <article id="experience">
      <h2>Research experience</h2>
      <p>Summarize positions, collaborations, and major project outcomes.</p>
    </article>

    <article id="skills">
      <h2>Skills</h2>
      <ul class="tag-list">
        <li>Python</li>
        <li>C++</li>
        <li>TypeScript</li>
        <li>Astro</li>
        <li>Monte Carlo</li>
        <li>Scientific computing</li>
      </ul>
    </article>
  </section>
</BaseLayout>
