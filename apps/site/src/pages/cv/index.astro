---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="CV | Your Name">
  <section class="hero">
    <p class="eyebrow">CV</p>
    <h1>Curriculum vitae</h1>
    <p class="lead">
      Academic background, research experience, and technical skills in one concise profile.
    </p>
  </section>

  <div class="stack">
    <article class="card">
      <h2>Education</h2>
      <p>Doctoral / graduate / undergraduate record goes here.</p>
    </article>
    <article class="card">
      <h2>Research experience</h2>
      <p>Research assistantships, scientific collaborations, and domain-specific projects.</p>
    </article>
    <article class="card">
      <h2>Skills</h2>
      <ul class="tag-list">
        <li>Python</li>
        <li>C++</li>
        <li>TypeScript</li>
        <li>Astro</li>
        <li>Monte Carlo</li>
        <li>Scientific computing</li>
      </ul>
    </article>
  </div>
</BaseLayout>
