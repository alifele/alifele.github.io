---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Research | Your Name">
  <section class="hero">
    <p class="eyebrow">Research</p>
    <h1>Scientific interests and active work</h1>
    <p class="lead">
      This section organizes my research themes, current projects, and computational methods.
    </p>
  </section>

  <div class="grid">
    <article class="card">
      <h2>Stochastic processes</h2>
      <p>Random walks, diffusion, Markov chains, and non-equilibrium dynamics.</p>
      <a href="/simulations/">Explore simulations →</a>
    </article>
    <article class="card">
      <h2>Statistical mechanics</h2>
      <p>Monte Carlo methods, ensembles, phase transitions, and sampling diagnostics.</p>
      <a href="/projects/">View project library →</a>
    </article>
    <article class="card">
      <h2>Computational methods</h2>
      <p>Numerical experiments, reproducible notes, and scientific software.</p>
      <a href="/computational-notes/">See notes →</a>
    </article>
  </div>

  <section class="section">
    <h2>Current focus</h2>
    <ul class="tag-list">
      <li>Markov chains</li>
      <li>Molecular simulation</li>
      <li>Monte Carlo</li>
      <li>Scientific computing</li>
      <li>Interactive visualization</li>
    </ul>
  </section>
</BaseLayout>
