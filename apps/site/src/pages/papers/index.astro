---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Papers | Your Name">
  <section class="hero">
    <p class="eyebrow">Papers</p>
    <h1>Publications, preprints, and writing</h1>
    <p class="lead">
      This page is the scaffold for published work, manuscripts, and technical writing.
    </p>
  </section>

  <div class="stack">
    <article class="card">
      <h2>Example publication</h2>
      <p><strong>Title:</strong> A computational study of stochastic transport and sampling.</p>
      <p><strong>Status:</strong> Draft / placeholder</p>
    </article>
    <article class="card">
      <h2>Preprints</h2>
      <p>Link to working drafts, technical notes, and arXiv-ready summaries.</p>
    </article>
    <article class="card">
      <h2>Talks and presentations</h2>
      <p>Conferences, invited lectures, and workshops connected to the research narrative.</p>
    </article>
  </div>
</BaseLayout>
