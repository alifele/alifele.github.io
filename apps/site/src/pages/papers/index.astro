---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Papers | Your Name">
  <section class="hero">
    <p class="eyebrow">Papers</p>
    <h1>Publications, preprints, and technical writing</h1>
    <p class="lead">
      A reading-oriented archive of publication material, manuscripts, and presentation outputs.
    </p>
    <div class="quick-nav">
      <a href="#published">Published</a>
      <a href="#preprints">Preprints</a>
      <a href="#talks">Talks</a>
    </div>
  </section>

  <section class="reading-section">
    <article id="published">
      <h2>Published work</h2>
      <p>Peer-reviewed papers and finalized manuscripts are listed here with links and context.</p>
      <ul class="muted-list">
        <li>Topic overview and abstract summary</li>
        <li>Link to journal or archive version</li>
        <li>Supporting code and reproducibility notes</li>
      </ul>
    </article>

    <article id="preprints">
      <h2>Preprints and drafts</h2>
      <p>In-progress manuscripts, technical reports, and draft notes for active research projects.</p>
      <ul class="muted-list">
        <li>Method-focused drafts</li>
        <li>Exploratory computational reports</li>
        <li>Iteration history and updates</li>
      </ul>
    </article>

    <article id="talks">
      <h2>Talks and presentations</h2>
      <p>Slides, talk notes, and workshop material tied to research and software projects.</p>
      <ul class="muted-list">
        <li>Conference talks and invited lectures</li>
        <li>Research-group presentations</li>
        <li>Tutorial sessions with demonstration links</li>
      </ul>
    </article>
  </section>
</BaseLayout>
