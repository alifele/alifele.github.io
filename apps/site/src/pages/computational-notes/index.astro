---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Computational Notes | Your Name">
  <section class="hero">
    <p class="eyebrow">Computational notes</p>
    <h1>Quarto-driven scientific writing</h1>
    <p class="lead">
      Reproducible mathematical writeups, numerical experiments, and data-driven notes.
    </p>
  </section>

  <div class="stack">
    <article class="card">
      <h2>Monte Carlo notes</h2>
      <p>Algorithms, diagnostics, and sampling experiments documented with Quarto.</p>
    </article>
    <article class="card">
      <h2>Stochastic processes</h2>
      <p>Analytical derivations and numerical simulations for diffusion and Markov models.</p>
    </article>
    <article class="card">
      <h2>Research notebooks</h2>
      <p>Reproducible notes for analysis, modeling, and computational investigation.</p>
    </article>
  </div>
</BaseLayout>
