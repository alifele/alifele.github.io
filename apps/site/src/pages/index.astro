---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Your Name">
  <h1>Your Name</h1>

  <p>
    Researcher interested in mathematics, statistical physics,
    stochastic simulation, scientific computing and electronics.
  </p>

  <div class="grid">
    <div class="card">
      <h2>Research</h2>
      <p>Papers, current projects and research interests.</p>
      <a href="/research/">Explore →</a>
    </div>

    <div class="card">
      <h2>Software</h2>
      <p>Scientific software, simulation tools and implementations.</p>
      <a href="/projects/">Explore →</a>
    </div>

    <div class="card">
      <h2>Interactive simulations</h2>
      <p>
        Molecular dynamics, stochastic processes and statistical physics.
      </p>
      <a href="/simulations/">Explore →</a>
    </div>

    <div class="card">
      <h2>Electronics</h2>
      <p>Circuits, measurements and electronics experiments.</p>
      <a href="/projects/">Explore →</a>
    </div>

    <div class="card">
      <h2>Notes</h2>
      <p>My public Obsidian knowledge garden.</p>
      <a href="/notes/">Open notes →</a>
    </div>

    <div class="card">
      <h2>Computational notes</h2>
      <p>Quarto notebooks and mathematical experiments.</p>
      <a href="/computational-notes/">Open notes →</a>
    </div>
  </div>
</BaseLayout>
